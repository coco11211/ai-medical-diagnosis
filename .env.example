# Environment Configuration for AI Medical Diagnosis System

# Device Configuration
DEVICE=cuda  # Use 'cpu' for CPU-only Windows 11 systems, 'cuda' for GPU

# Database Configuration
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medical_diagnosis.db
DB_USER=
DB_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# Model Configuration
MODEL_PATH=data/models
CHECKPOINT_PATH=data/models/checkpoints

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Windows 11 Specific
PYTHONIOENCODING=utf-8
